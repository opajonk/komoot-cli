{
  "name": "Rust",
  "image": "mcr.microsoft.com/devcontainers/rust:1-1-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true
      },
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb"
      ]
    }
  },
  "postCreateCommand": "bash -lc 'set -euo pipefail; rustup component add rustfmt clippy; cargo fetch'",
  "postStartCommand": "bash -lc 'cargo check'",
  "remoteUser": "vscode"
}
